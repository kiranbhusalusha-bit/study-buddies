extends layout

block content
    div.container

        div.box
            h2 Study Request

        if success
            div.box
                p #{success}

        div.request-button
            a(href="/create-request") [ Create Study Request ]

        div.box
            form(action="/study-requests" method="GET")
                label Filter:
                input(type="text" name="q" placeholder="Search request or subject")
                button(type="submit") Search
                a(href="/study-requests") [ Clear ]

        div.box.request-list
            each request in data
                div.request-card
                    p Request Title: #{request.title}
                    p Subject: #{request.subject}
                    if request.description
                        p Description: #{request.description}
                    p
                        a(href="/study-request/" + request.id) [ View Details ]

            div.pagination
                if previousPage
                    a(href="/study-requests?page=" + previousPage + queryString) [ Previous ]
                else
                    span [ Previous ]

                |  

                if nextPage
                    a(href="/study-requests?page=" + nextPage + queryString) [ Next ]
                else
                    span [ Next ]