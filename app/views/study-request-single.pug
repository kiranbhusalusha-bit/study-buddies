extends layout

block content
    div.container

        div.box
            h2 Study Request Details

        div.back-button
            a(href="/study-requests") < Back to Study Requests

        if request
            div.box
                p Request Title: #{request.title}
                p Subject: #{request.subject}

            div.box
                p Full Description
                if request.description
                    p #{request.description}
                else
                    p No description added.

            div.box
                p Created By
                if request.student_name
                    p Student Name: #{request.student_name}
                    p Course / Year: #{request.course}, Year #{request.study_year}
                else
                    p Creator details not available.
        else
            div.box
                p Study request not found.