extends layout

block content
    div.container

        div.box
            h2 Student Profile Page

        div.box
            a(href="/") Home
            |  | 
            a(href="/study-buddies") Study Buddies
            |  | 
            a(href="/study-requests") Study Requests
            |  | 
            a(href="/create-request") Create Study Request
            |  | 
            a(href="/logout") Logout

        div.nav-row
            a.button-link(href="/study-buddies") < Back to User List
            - var isOwnProfile = loggedIn && currentUserId && (currentUserId === student.id)
            if isOwnProfile
                a.button-link(href="/messages/inbox") View Messages
                a.button-link(href="/profile/" + student.id) Edit Profile

        div.box
            if student.picture
                img.profile-pic(src=student.picture, alt=student.name + " profile picture")
            else
                img.profile-pic(src="/images/default-avatar.svg", alt="Default profile picture")

            if isOwnProfile
                form.picture-form(action="/single-student/" + student.id + "/picture", method="POST")
                    div.form-group
                        label(for="picture") Add / Change Profile Picture URL:
                        input(type="url", id="picture", name="picture", value=student.picture || "", placeholder="https://example.com/my-photo.jpg")
                    button(type="submit") Save Picture

        div.box
            p Student Name: #{student.name}
            p Student ID: #{student.id}

        div.box
            p Short Bio / Description
            if student.note
                p #{student.note}
            else
                p No description added yet.

        div.box
            p Subjects They Can Help With
            if student.subjects && student.subjects.length
                each subject in student.subjects
                    p • #{subject.name}
            else
                p No subjects listed.

        div.box
            p Subjects They Need Help With
            p • Not added yet

        div.box
            p Availability
            p • Not added yet

        if loggedIn && currentUserId && currentUserId != student.id
            div.send-message-section
                a.send-message-button(href="/messages/new/" + student.id) Send Message
