extends layout

block content
    div.container

        div.box
            h2 Create Study Request

        if error
            div.box
                p #{error}

        if success
            div.box
                p #{success}

        div.box
            form(action="/create-request" method="POST")
                p Title:
                input(type="text" name="title" value=title)

                p Subject:
                input(type="text" name="subject" value=subject)

                p Description:
                textarea(name="description") #{description}

                br
                button(type="submit") Submit

        p
            a(href="/study-requests") Back to Study Requests