extends layout

block content
    div.container

        div.box
            h2 Create Study Request

        div.box
            form(action="/create-request" method="POST")
                p Title:
                input(type="text" name="title")

                p Subject:
                input(type="text" name="subject")

                p Description:
                textarea(name="description")

                br
                button(type="submit") Submit