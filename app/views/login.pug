extends layout

block content
    div.container

        div.box
            h1 Login here

        div.box
            form(action="/authenticate" method="POST")
                label(for="email") Enter your email:
                input(name="email")

                br
                br

                label(for="password") Enter your password:
                input(name="password" type="password")

                br
                br

                input(type="submit" value="Login")

        div.box
            p New user?
            a(href="/register") Register here