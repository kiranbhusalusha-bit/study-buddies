extends layout

block content
    div.user-list-shell
        div.user-list-panel
            div.user-list-heading
                span.sparkle *
                div
                    h2 Find a Study Buddy (User List Page)
                    span.heading-mark

            form.user-search(action="/study-buddies" method="GET")
                label.sr-only(for="buddy-search") Search
                input#buddy-search(type="text" name="q" placeholder="Enter subject or keyword..." value=(typeof q !== "undefined" ? q : ""))
                button(type="submit") Search

            div.filter-card
                span.filter-title Filters / Tags
                a.filter-pill.maths(href="/study-buddies?tag=Maths") Maths
                a.filter-pill.programming(href="/study-buddies?tag=Programming") Programming
                a.filter-pill.year(href="/study-buddies?tag=First Year") First Year
                a.filter-pill.business(href="/study-buddies?tag=Business") Business
                a.filter-pill.more(href="/study-buddies") More...

            div.study-buddy-list
                if dbError
                    p.empty-list #{dbError}
                if data && data.length
                    each student in data
                        div.buddy-card(data-student-id=student.id)
                            div.avatar-picker
                                img.buddy-avatar(src=(student.picture || "/images/default-avatar.svg") alt=student.name + " profile picture")

                            div.buddy-info
                                h3 Student Name: #{student.name}
                                if student.course || student.study_year
                                    p.meta-line
                                        span.icon-circle
                                        | Course / Year: #{student.course || "Not added"}, Year #{student.study_year || "Not added"}
                                else
                                    p.meta-line
                                        span.icon-circle
                                        | Course / Year: Not added
                                if student.subjects
                                    p.meta-line
                                        span.book-icon
                                        | Subjects: #{student.subjects}
                                else if student.note
                                    p.meta-line
                                        span.book-icon
                                        | Subjects: #{student.note}
                                else
                                    p.meta-line
                                        span.book-icon
                                        | Subjects: Not added

                            a.profile-button(href="/single-student/" + student.id) View Profile
                else if !dbError
                    p.empty-list No students found.

            div.user-pagination
                if previousPage
                    a.page-button(href="/study-buddies?page=" + previousPage + queryString) Previous
                else
                    span.page-button.disabled Previous

                if nextPage
                    a.page-button.primary(href="/study-buddies?page=" + nextPage + queryString) Next
                else
                    span.page-button.primary.disabled Next
