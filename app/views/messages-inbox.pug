extends layout

block content
    h1 View Messages

    if messages.length
        each msg in messages
            div.message-card
                p
                    strong From:
                    a(href="/single-student/" + msg.sender_id)= msg.sender_name
                p
                    strong Message:
                    |  #{msg.body}
                p
                    strong Received:
                    |  #{msg.created_at}
                form.reply-form(action="/messages/new/" + msg.sender_id, method="POST")
                    textarea(name="body", placeholder="Reply to " + msg.sender_name + "...", rows="3")
                    br
                    button.reply-button(type="submit") Reply
    else
        p You have no new messages.

    p
        a(href="/single-student/" + currentUserId) Back to your profile
