extends layout

block content
    h1 Study Buddy Profile

    if student
        table(border=1)
            tr
                th ID
                td #{student.id}
            tr
                th Name
                td #{student.name}

        p
            a(href="/all-students-formatted") Back to all students
    else
        p Student not found.
        p
            a(href="/all-students-formatted") Back to all students