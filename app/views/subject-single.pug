extends layout

block content
    h1 Subject Details

    if subject
        table(border=1)
            tr
                th ID
                td #{subject.id}
            tr
                th Subject Name
                td #{subject.name}

        h2 Students linked to this subject

        if students.length
            table(border=1)
                tr
                    th ID
                    th Name
                each student in students
                    tr
                        td #{student.id}
                        td
                            a(href='/single-student/' + student.id) #{student.name}
                        
        else
            p No students are linked to this subject yet.

        p
            a(href="/subjects") Back to Subjects
    else
        p Subject not found.
        p
            a(href="/subjects") Back to Subjects