extends layout

block content
    div.container

        div.box
            h1 Study Buddies (Logo + Site Name)

        div.box
            a(href="/") Home
            |  | 
            a(href="/study-buddies") Study Buddies
            |  | 
            a(href="/study-requests") Study Requests
            |  | 
            a(href="/login") Login/Profile
            |  | 
            a(href="/search") 🔍 Search
            |  | 
            a(href="/about") About


        div.box
            h2 Welcome to Study Buddies
            p A platform to find study partners, share knowledge, and collaborate.

        div.button-group
            a(href="/study-buddies")
                button View Study Buddies
            a(href="/study-requests")
                button View Study Request

        div.box
            h2 How It Works
            p • Create your profile
            p • Search by subject or tags
            p • Browse study buddies
            p • Create and view study requests
            p • Message students to arrange sessions

        div.box
            p Contact | About | Privacy Policy | © 2026 Study Buddies